# Шаблон настроек. Скопируйте в .env (или экспортируйте вручную в окружение ОС):
#   cp .env.example .env
# Затем загрузите в окружение:
#   set -a && . ./.env && set +a
# Программы (Python, Go, Rust) читают эти значения из переменных окружения ОС.

# Путь к shapefile с запретными (аномальными) зонами
SHAPEFILE=/opt/filter/restrict.shp

# Максимальная допустимая скорость судна, узлы
MAX_SPEED=20

# Допустимая разница между расчётной скоростью и скоростью по данным терминала, узлы
DIFF_SPEED=15